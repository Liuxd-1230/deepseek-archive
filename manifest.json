{
  "manifest_version": 3,
  "name": "DeepSeek 对话存档",
  "version": "0.2.2",
  "description": "自动存档 DeepSeek 对话（含思考全文与原始 Markdown），被过滤的内容也能找回。数据只存在本地，可导出、可备份。",
  "permissions": ["storage", "unlimitedStorage", "webRequest", "sidePanel"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/recorder-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/recorder-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开对话存档侧栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
